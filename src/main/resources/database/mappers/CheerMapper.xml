<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lifeEgg.dao.CheerDAO">

<insert id="create">
insert into cheer (content, user_id, parent_id, uuid, preview) values (#{content}, #{user_id}, #{parent_id},
 #{uuid}, #{preview})
</insert>

<select id="readByUserId" resultType="hashmap">
select * from cheer where user_id = #{userId}
</select>

<select id="readByUuid" resultType="CheerDTO">
select * from cheer where uuid = #{uuid}
</select>

<select id="readIdByUuid" resultType="Long">
select id from cheer where uuid = #{uuid}
</select>

<select id="readCheerAlarmDTOByUuid" resultType="CheerAlarmDTO">
		select id cheerId, preview cheerPreview from post where uuid = #{uuid}
	</select>


<delete id="delete"> 
delete from cheer where id = #{id} 
</delete>

<delete id="deleteByUuid"> 
delete from cheer where uuid = #{uuid} 
</delete>


</mapper>